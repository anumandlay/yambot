# Production non-secret defaults committed for pull-deploy.
# On the server, overlay secrets via an untracked `.env` file
# (MONGODB_URI, JWT_SECRET, SETTINGS_CRYPTO_KEY) — do not rewrite this file on each pull.

NODE_ENV=production
PORT=4000
PUBLIC_API_URL=https://bot.vughy.com
CORS_ORIGINS=https://bot.vughy.com,http://bot.vughy.com
JWT_EXPIRES_IN=7d
