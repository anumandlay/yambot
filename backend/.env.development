# Local development — copy to .env.development if needed.
# Secrets for local only; do not put production secrets here.

NODE_ENV=development
PORT=4000
# Public URL the frontend / extension use to reach this API locally
PUBLIC_API_URL=http://localhost:4000
MONGODB_URI=mongodb://127.0.0.1:27017/yambot
JWT_SECRET=dev-change-me-yambot-jwt-secret
JWT_EXPIRES_IN=7d
# Optional AES key for encrypting stored LLM API keys (32+ chars)
SETTINGS_CRYPTO_KEY=dev-settings-crypto-key-change-me-32
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
