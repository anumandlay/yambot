/**
 * @fileoverview Server-local secrets overlay template (DO NOT COMMIT real values).
 * Purpose: On production, copy to `.env` and fill Mongo/JWT secrets. Pulls won't overwrite this file if it stays untracked.
 */

MONGODB_URI=mongodb://USER:PASS@HOST:27017/yambot
JWT_SECRET=replace-with-long-random-string
SETTINGS_CRYPTO_KEY=replace-with-another-long-random-string

# Public URLs (OAuth redirect uses PUBLIC_API_URL)
PUBLIC_API_URL=https://bot.vughy.com
PUBLIC_WEB_URL=https://bot.vughy.com

# LLM OAuth — optional; only providers with client_id appear in Settings
AZURE_OPENAI_OAUTH_CLIENT_ID=
AZURE_OPENAI_OAUTH_CLIENT_SECRET=
AZURE_OPENAI_OAUTH_TENANT_ID=common

GOOGLE_GEMINI_OAUTH_CLIENT_ID=
GOOGLE_GEMINI_OAUTH_CLIENT_SECRET=

OPENAI_OAUTH_CLIENT_ID=
OPENAI_OAUTH_CLIENT_SECRET=
# OPENAI_OAUTH_AUTHORIZE_URL=https://auth.openai.com/oauth/authorize
# OPENAI_OAUTH_TOKEN_URL=https://auth.openai.com/oauth/token
# OPENAI_OAUTH_SCOPE=openid profile email offline_access

# LiteLLM gateway (optional — production Compose sets LITELLM_PROXY_URL=http://litellm:4000)
# LITELLM_PROXY_URL=http://127.0.0.1:4000
# LITELLM_MASTER_KEY=sk-litellm-master-change-me
# LITELLM_DEFAULT_MODEL=minimax
