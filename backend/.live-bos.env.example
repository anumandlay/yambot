# LIVE_BOS controlled real E2E credentials (DO NOT COMMIT)
# Copy to: backend/.live-bos.env
#
# TEST_ONLY is required (default 1). Never point at production CRM/customers.

LIVE_BOS=0
LIVE_BOS_TEST_ONLY=1
LIVE_BOS_ALLOW_PRODUCTION=0

# --- Test API (throwaway / public staging) ---
# LIVE_BOS_API_BASE_URL=https://jsonplaceholder.typicode.com
# LIVE_BOS_API_KEY=
# LIVE_BOS_API_GET_PATH=/users
# LIVE_BOS_API_POST_PATH=/posts

# --- Dedicated test mailbox (SMTP send requires ALLOW_MAIL_MUTATION=1) ---
# LIVE_BOS_IMAP_HOST=mail.example.com
# LIVE_BOS_IMAP_PORT=993
# LIVE_BOS_IMAP_USER=livebos-test@example.com
# LIVE_BOS_IMAP_PASS=
# LIVE_BOS_SMTP_HOST=mail.example.com
# LIVE_BOS_SMTP_PORT=587
# LIVE_BOS_CUSTOMER_EMAIL=livebos-test@example.com
# LIVE_BOS_ALLOW_MAIL_MUTATION=0

# --- Browser agent (cloud worker must be online to PASS) ---
# LIVE_BOS_BROWSER_URL=https://example.com
# LIVE_BOS_BROWSER_WAIT_MS=12000

# LIVE_BOS_ALLOW_CRASH=0
