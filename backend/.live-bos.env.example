# LIVE_BOS controlled integration credentials (DO NOT COMMIT)
# Copy to: backend/.live-bos.env  then set LIVE_BOS=1
#
# Scaffold default: leave LIVE_BOS unset → all scenarios SKIP (not fail).

LIVE_BOS=0

# --- Real test API (throwaway / staging) ---
# LIVE_BOS_API_BASE_URL=https://api.example-test.com/v1
# LIVE_BOS_API_KEY=replace-me
# LIVE_BOS_API_GET_PATH=/customers
# LIVE_BOS_API_POST_PATH=/customers/status

# --- Real test mailbox (IMAP login probe; mutation optional) ---
# LIVE_BOS_IMAP_HOST=imap.example.com
# LIVE_BOS_IMAP_PORT=993
# LIVE_BOS_IMAP_USER=livebos-test@example.com
# LIVE_BOS_IMAP_PASS=replace-me
# LIVE_BOS_SMTP_HOST=smtp.example.com
# LIVE_BOS_SMTP_PORT=587
# LIVE_BOS_ALLOW_MAIL_MUTATION=0

# --- Optional browser / test site ---
# LIVE_BOS_BROWSER_URL=https://example-test.com/login
# LIVE_BOS_BROWSER_USER=
# LIVE_BOS_BROWSER_PASS=

# --- Chaos: allow documenting worker-kill tests (does not auto-kill by default) ---
# LIVE_BOS_ALLOW_CRASH=0
