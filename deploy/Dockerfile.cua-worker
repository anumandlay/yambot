# YamBot Cua cloud computer — Playwright Chrome on the Cua XFCE desktop.
# Build context: repo root (see docker-compose worker-cua-image).
# Why: optional engine for agents that need a full Linux desktop (Take control)
# while keeping the existing Playwright LLM action loop. Not the shared
# OpenMausBot `openmausbot-computer` container — each YamBot agent still gets its own box.
#
# Base digest matches the OpenMausBot Local VM (trycua/xfce-cua).

FROM docker.io/trycua/xfce-cua@sha256:274eb636f5cf3fc58f705916ee72b7a701270b3877369d08533a385c5325be9b

USER root
WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC \
    PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright

# Node 20 is required by worker/package.json; Cua image does not ship it.
ARG NODE_VERSION=20.19.4
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      xz-utils \
      novnc \
      websockify \
      socat \
      x11-xserver-utils \
      fonts-liberation \
      fonts-noto-color-emoji \
      python3 \
  && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
      | tar -xJ -C /usr/local --strip-components=1 \
  && rm -rf /var/lib/apt/lists/*

COPY worker/package.json ./
RUN npm install --omit=dev \
  && npx playwright install chrome \
  && npx playwright install-deps chrome || true

COPY worker/src ./src
COPY worker/cua_hermes ./cua_hermes
COPY worker/extension /app/extension
COPY worker/entrypoint-cua.sh /app/entrypoint-cua.sh

# Why: Windows checkouts often ship CRLF; Linux then fails with a missing shebang file.
RUN sed -i 's/\r$//' /app/entrypoint-cua.sh \
  && sed -i 's/\r$//' /app/cua_hermes/sidecar.py \
  && chmod +x /app/entrypoint-cua.sh /app/cua_hermes/sidecar.py

ENV YAMBOT_TEACH_EXTENSION_DIR=/app/extension \
    NODE_ENV=production \
    DISPLAY=:1 \
    YAMBOT_HEADED=1 \
    YAMBOT_CUA=1 \
    YAMBOT_BROWSER_CHANNEL=chrome \
    YAMBOT_PROFILE_DIR=/data/browser-profile \
    YAMBOT_POLL_MS=5000 \
    YAMBOT_NOVNC_PORT=6080 \
    YAMBOT_VIEWPORT_WIDTH=1280 \
    YAMBOT_VIEWPORT_HEIGHT=800 \
    YAMBOT_CUA_HERMES_SIDECAR=/app/cua_hermes/sidecar.py \
    YAMBOT_CUA_PYTHON=python3 \
    CUA_DRIVER_PERMISSION_MODE=unrestricted \
    CUA_DRIVER_DANGEROUSLY_BYPASS_APPROVALS=1

EXPOSE 6080 6901

VOLUME ["/data/browser-profile"]

CMD ["/app/entrypoint-cua.sh"]
