# Copy to deploy/.env on the server only (do not commit real secrets).
NODE_ENV=production
PORT=4000
PUBLIC_API_URL=https://bot.vughy.com
CORS_ORIGINS=https://bot.vughy.com,http://bot.vughy.com
JWT_SECRET=change-me-to-a-long-random-string
SETTINGS_CRYPTO_KEY=change-me-to-another-long-random-string
JWT_EXPIRES_IN=7d
VITE_API_BASE_URL=https://bot.vughy.com

# Cloud worker (docker-compose.workers.yml) — one set of creds per user; unique AGENT_ID per box
# Inside Compose network use http://api:4000; from outside use https://bot.vughy.com
YAMBOT_API_BASE_URL=http://api:4000
YAMBOT_EMAIL=
YAMBOT_PASSWORD=
YAMBOT_AGENT_ID=
YAMBOT_WORKER_NAME=cloud-agent-1
