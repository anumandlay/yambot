# Copy to deploy/.env on the server only (do not commit real secrets).
NODE_ENV=production
PORT=4000
PUBLIC_API_URL=https://bot.vughy.com
CORS_ORIGINS=https://bot.vughy.com,http://bot.vughy.com
JWT_SECRET=change-me-to-a-long-random-string
SETTINGS_CRYPTO_KEY=change-me-to-another-long-random-string
JWT_EXPIRES_IN=7d
VITE_API_BASE_URL=https://bot.vughy.com

# computer-manager (auto agent boxes)
DOCKER_NETWORK=deploy_default
YAMBOT_API_BASE_URL=http://api:4000

# Site-wide LLM (seeded into every user on API boot). Keep the key only on the server.
DEFAULT_LLM_BASE_URL=https://api.minimax.io/v1
DEFAULT_LLM_MODEL=MiniMax-M2.7
DEFAULT_LLM_API_KEY=

# SaaS platform super-admin (optional — set on production server only)
# SUPERADMIN_BOOTSTRAP_EMAIL=admin@yourcompany.com
# SUPERADMIN_BOOTSTRAP_PASSWORD=use-a-long-random-password
# SUPERADMIN_BOOTSTRAP_NAME=Platform Admin
# SUPERADMIN_EMAILS=admin@yourcompany.com,ops@yourcompany.com

# Stripe wallet top-ups (server-side only)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PUBLIC_WEB_URL=https://bot.vughy.com

