# YamBot cloud computer — Playwright Chromium on Xvfb + noVNC remote desktop.
# Build context: repo root (see docker-compose).
# Why: Live Wall "Take control" embeds noVNC so the user drives the same browser as the agent.

FROM mcr.microsoft.com/playwright:v1.54.2-jammy

USER root
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    fluxbox \
    xterm \
    fonts-liberation \
    fonts-noto-color-emoji \
  && rm -rf /var/lib/apt/lists/*

COPY worker/package.json ./
RUN npm install --omit=dev

COPY worker/src ./src
COPY worker/entrypoint.sh /app/entrypoint.sh
# Why: research + real-tab content scripts need the same MV3 extension as laptop Chrome.
COPY extension ./extension

RUN chmod +x /app/entrypoint.sh

ENV NODE_ENV=production \
    DISPLAY=:99 \
    YAMBOT_HEADED=1 \
    YAMBOT_PROFILE_DIR=/data/browser-profile \
    YAMBOT_EXTENSION_DIR=/app/extension \
    YAMBOT_LOAD_EXTENSION=1 \
    YAMBOT_POLL_MS=5000 \
    YAMBOT_NOVNC_PORT=6080 \
    YAMBOT_VNC_PORT=5900 \
    YAMBOT_VIEWPORT_WIDTH=1280 \
    YAMBOT_VIEWPORT_HEIGHT=800

EXPOSE 6080

VOLUME ["/data/browser-profile"]

CMD ["/app/entrypoint.sh"]
