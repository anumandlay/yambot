# YamBot cloud computer — Google Chrome (via Playwright channel) on Xvfb + noVNC.
# Build context: repo root (see docker-compose).
# Why: Real Chrome improves Google OAuth/login vs bundled Playwright Chromium.

FROM mcr.microsoft.com/playwright:v1.54.2-jammy

USER root
WORKDIR /app

# Why: tzdata otherwise blocks the image build with an interactive “Geographic area” prompt.
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    fluxbox \
    xterm \
    xdotool \
    fonts-liberation \
    fonts-noto-color-emoji \
  && rm -rf /var/lib/apt/lists/*

COPY worker/package.json ./
RUN npm install --omit=dev \
  && npx playwright install chrome

COPY worker/src ./src
COPY worker/entrypoint.sh /app/entrypoint.sh

# Why: Windows checkouts often ship CRLF; Linux then fails with
# `exec /app/entrypoint.sh: no such file or directory` (shebang becomes /bin/bash\r).
RUN sed -i 's/\r$//' /app/entrypoint.sh && chmod +x /app/entrypoint.sh

ENV NODE_ENV=production \
    DISPLAY=:99 \
    YAMBOT_HEADED=1 \
    YAMBOT_BROWSER_CHANNEL=chrome \
    YAMBOT_PROFILE_DIR=/data/browser-profile \
    YAMBOT_POLL_MS=5000 \
    YAMBOT_NOVNC_PORT=6080 \
    YAMBOT_VNC_PORT=5900 \
    YAMBOT_VIEWPORT_WIDTH=1280 \
    YAMBOT_VIEWPORT_HEIGHT=800

EXPOSE 6080

VOLUME ["/data/browser-profile"]

CMD ["/app/entrypoint.sh"]
